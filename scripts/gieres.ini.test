# Gieres "Radio Radio" endpoint override for bootamp — test config.
# Copy to ~/.config/bootamp/gieres.ini and edit. Keys:
#   base_url — archive server base. The built-in default is the public
#   endpoint below; the LAN server is the author's fastest route
#   (docs/orgonity-api.md).
base_url = https://gieres.cytr.us
